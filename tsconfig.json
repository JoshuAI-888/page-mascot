{
  "compilerOptions": {
    "target": "es2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": [
      "vite/client",
      "node"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "src",
    "site",
    "vite.config.ts",
    "maia",
    "vite.maia.config.ts",
    "vite.widget.config.ts",
    "web-src",
    "vite.maia-web.config.ts"
  ]
}
